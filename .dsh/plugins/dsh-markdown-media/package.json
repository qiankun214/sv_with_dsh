{
  "name": "dsh-markdown-media",
  "version": "0.1.0",
  "description": "dsh Web GUI 扩展：Markdown 里的图片按当前文档解析并可直接显示，Mermaid 围栏画成图，图片与图表点击放大。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "mermaid",
    "markdown"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiankun214/sv_with_dsh.git",
    "directory": ".dsh/plugins/dsh-markdown-media"
  },
  "bugs": {
    "url": "https://github.com/qiankun214/sv_with_dsh/issues"
  },
  "homepage": "https://github.com/qiankun214/sv_with_dsh/tree/main/.dsh/plugins/dsh-markdown-media",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "THIRD-PARTY-NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^27.0.0",
    "mermaid": "^11.17.2"
  }
}
