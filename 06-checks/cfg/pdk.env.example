# PDK 定位配置样例 —— 复制为 06-checks/cfg/pdk.env 后按实际路径填写
#
#   cp 06-checks/cfg/pdk.env.example 06-checks/cfg/pdk.env
#
# pdk.env 不入库（含机器本地路径）。优先级高于同名环境变量。
# 三项都可以留空：留空时 tools/sv.py 会依次尝试
#   1) 环境变量 PDK_ROOT / SKY130_LIB / SKY130_VERILOG
#   2) <仓根>/06-checks/cfg/pdk.env
#   3) 在 $PDK_ROOT/sky130A/libs.ref/sky130_fd_sc_hd/ 下自动 glob 发现

# PDK 根目录（其下应有 sky130A/ 子目录，open_pdks 布局）
PDK_ROOT=/home/USER/pdk

# Liberty：留空则自动找 lib/sky130_fd_sc_hd__tt_025C_1v80.lib，
# 找不到再退化为按 */lib/*.lib 取第一个
SKY130_LIB=

# 标准单元行为模型：留空则自动找 verilog/sky130_fd_sc_hd.v
SKY130_VERILOG=
