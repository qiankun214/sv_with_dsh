# Yosys 综合脚本模板（sky130 真实映射）
#
# 由 tools/sv.py gate 06 渲染：read_verilog -sv /home/alpaca/sv_with_dsh/04-rtl/rr_arbiter/rr_arbiter.sv rr_arbiter /home/alpaca/sv_with_dsh/.tools/pdk/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib /home/alpaca/sv_with_dsh/06-checks/reports/rr_arbiter/synth/rr_arbiter.netlist.v 会被替换为绝对路径，
# 渲染结果写到 06-checks/reports/<module>/synth/run.ys 再交给 `yosys -s` 执行。
# 手工跑法：yosys -s <渲染后的 run.ys>

# 1) 读入设计
read_verilog -sv /home/alpaca/sv_with_dsh/04-rtl/rr_arbiter/rr_arbiter.sv

# 2) 精化与检查（-check 会因端口未驱动/多驱动等报错）
hierarchy -check -top rr_arbiter

# 3) 通用综合
proc
opt
fsm
opt
memory
opt
techmap
opt

# 4) 映射到 sky130 标准单元
dfflibmap -liberty /home/alpaca/sv_with_dsh/.tools/pdk/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty /home/alpaca/sv_with_dsh/.tools/pdk/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
opt
clean

# 5) 报告
stat -liberty /home/alpaca/sv_with_dsh/.tools/pdk/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
ltp -noff

# 6) 网表落盘（大产物，已在 .gitignore 中忽略）
write_verilog -noattr /home/alpaca/sv_with_dsh/06-checks/reports/rr_arbiter/synth/rr_arbiter.netlist.v
